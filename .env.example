# --- DevLens environment variables ---
# Copy this file to .env and fill in your real keys. Never commit .env.

# GitHub token (optional but recommended) to avoid low unauthenticated
# rate limits when fetching repo contents from the GitHub REST API.
# Create one at https://github.com/settings/tokens (no special scopes needed
# for public repos).
GITHUB_TOKEN=

# --- AI Provider ---
# During development we use Groq (fast, free, OpenAI-compatible API).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Final hackathon submission uses Google Gemini (official requirement).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which provider main.py should call: "groq" or "gemini"
AI_PROVIDER=groq
